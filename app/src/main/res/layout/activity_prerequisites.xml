<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            tools:context=".ui.PrerequisitesActivity">

            <TextView
                android:id="@+id/tv_prerequisites_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="@string/prerequisites_title"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- A reusable layout for each check -->
            <include
                android:id="@+id/check_nfc_hce_capability"
                layout="@layout/item_prerequisite_check" />

            <include
                android:id="@+id/check_nfc_enabled"
                layout="@layout/item_prerequisite_check" />

            <include
                android:id="@+id/check_default_payment_app"
                layout="@layout/item_prerequisite_check" />

            <include
                android:id="@+id/check_biometric_setup"
                layout="@layout/item_prerequisite_check" />

            <include
                android:id="@+id/check_notification_permission"
                layout="@layout/item_prerequisite_check" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_continue_to_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:text="@string/prerequisites_continue"
                android:visibility="gone"
                app:cornerRadius="12dp"
                tools:visibility="visible" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
